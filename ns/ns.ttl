@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix login: <https://tophcodes.github.io/css-oidc-login/ns#> .

<https://tophcodes.github.io/css-oidc-login/ns>
    a owl:Ontology ;
    rdfs:label "css-oidc-login vocabulary" ;
    rdfs:comment """Terms a WebID profile uses to accept authentication by one
    subject at one external OpenID Connect provider. Used by css-oidc-login, a
    login method for the Community Solid Server.""" ;
    rdfs:seeAlso <https://github.com/tophcodes/css-oidc-login> .

login:externalLogin
    a rdf:Property ;
    rdfs:label "external login" ;
    rdfs:comment """Relates a WebID to a grant node carrying one issuer and one
    subject identifier. Neither half grants anything on its own. A profile may
    carry several grants, one per provider.""" ;
    rdfs:isDefinedBy <https://tophcodes.github.io/css-oidc-login/ns> .

login:issuer
    a rdf:Property ;
    rdfs:label "issuer" ;
    rdfs:comment """The issuer identifier of the provider a grant applies to,
    as an IRI. Compared against the iss claim of the ID token, ignoring a
    trailing slash. A literal does not satisfy it.""" ;
    rdfs:domain login:externalLogin ;
    rdfs:isDefinedBy <https://tophcodes.github.io/css-oidc-login/ns> .

login:subject
    a rdf:Property ;
    rdfs:label "subject identifier" ;
    rdfs:comment """The subject identifier the provider assigns to this person,
    as a literal. Compared exactly against the sub claim. This is what makes a
    grant name a person rather than a provider.""" ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://tophcodes.github.io/css-oidc-login/ns> .
