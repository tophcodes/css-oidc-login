{
  "compilerOptions": {
    "target": "ES2022",
    // The published artifact is CommonJS: the server that loads it constructs
    // every class with `require()`, and an ES module is not constructible that
    // way. `module: CommonJS` fixes the emit format here rather than reading
    // it off the nearest package.json, which is what lets `src/` stay an ES
    // module for the runtime that strips its types while `dist/` is required.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    // A relative import naming a `.ts` file is what Node's type stripping
    // resolves when the tests run against src/, and these two rewrite it to
    // `.js` on the way into dist/. A runtime import written as `./x.js`
    // resolves in dist/ but not in the test run, so relative imports that
    // survive erasure name the `.ts` file.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
